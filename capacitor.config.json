{
  "appId": "com.warpvanguard.game",
  "appName": "Warp Vanguard",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "zoomEnabled": false,
    "allowsLinkPreview": false,
    "preferredContentMode": "mobile",
    "backgroundColor": "#03060e"
  },
  "plugins": {
    "SystemBars": {
      "hidden": true
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true
    }
  }
}
