{
  "name": "warp-vanguard",
  "version": "1.0.4",
  "description": "A mobile game for iOS and Android - dual-emitter warp lane escort game",
  "main": "index.html",
  "scripts": {
    "start": "npm run build",
    "test": "node scripts/test.js && node scripts/test-board.js && node scripts/test-sfx-levels.mjs",
    "build:verifier": "node scripts/build-verifier.js",
    "deploy:verifier": "node scripts/build-verifier.js && supabase functions deploy submit-run",
    "build": "node scripts/build.js",
    "dev": "npm run build && node scripts/serve.js",
    "lab": "node scripts/lab.js",
    "lab:seed": "node scripts/lab-seed.js",
    "lab:dest": "node scripts/dest-lab.js",
    "ios": "npx cap open ios",
    "ios:build": "bash scripts/build-ios.sh",
    "android": "npx cap open android",
    "sync": "npm run build && npx cap sync",
    "apk": "bash scripts/build-apk.sh",
    "icons": "python3 scripts/icons.py",
    "verifier:status": "node scripts/verifier-status.js",
    "hooks:install": "git config core.hooksPath .githooks && echo \"git hooks active (.githooks/)\"",
    "lab:tune": "node scripts/tuning-board.js",
    "test:board": "node scripts/test-board.js",
    "test:freeze": "node scripts/test-weekly-freeze.mjs",
    "lab:disc": "node scripts/disc-lab.js",
    "lab:breach": "node scripts/breach-lab.js",
    "lab:sound": "node scripts/soundboard.js",
    "sfx:folders": "node scripts/sfx-folders.js",
    "sfx:fetch": "node scripts/sfx-fetch.js",
    "admin": "node scripts/admin.js",
    "portal": "node scripts/portal.js",
    "aab": "bash scripts/build-aab.sh",
    "version:sync": "node scripts/sync-version.js",
    "test:coverage": "node scripts/test-fingerprint-coverage.mjs"
  },
  "keywords": [
    "game",
    "mobile",
    "ios",
    "android",
    "capacitor"
  ],
  "author": "Gil",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0"
  }
}
