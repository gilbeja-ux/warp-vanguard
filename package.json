{
  "name": "warp-overwatch",
  "version": "1.0.0",
  "description": "A mobile game for iOS and Android - dual-emitter warp lane escort game",
  "main": "index.html",
  "scripts": {
    "start": "npm run build",
    "test": "node scripts/test.js",
    "build:verifier": "node scripts/build-verifier.js",
    "deploy:verifier": "node scripts/build-verifier.js && supabase functions deploy submit-run",
    "build": "node scripts/build.js",
    "dev": "npm run build && node scripts/serve.js",
    "lab": "node scripts/lab.js",
    "lab:seed": "node scripts/lab-seed.js",
    "lab:dest": "node scripts/dest-lab.js",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "sync": "npm run build && npx cap sync",
    "apk": "bash scripts/build-apk.sh"
  },
  "keywords": [
    "game",
    "mobile",
    "ios",
    "android",
    "capacitor"
  ],
  "author": "Gil",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0"
  }
}
