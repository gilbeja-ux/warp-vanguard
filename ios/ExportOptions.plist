<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- How `npm run ios:archive` turns the .xcarchive into an .ipa for App Store
     Connect. Signing is automatic: Xcode picks the distribution certificate
     and profile for the team it is signed into. `scripts/build-ios.sh` adds
     `teamID` at run time from IOS_TEAM_ID when more than one team is present. -->
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
