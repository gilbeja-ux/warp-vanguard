# ---- the iOS project ----
# Same rule as Android below: Capacitor regenerates most of it, but four files
# carry DECISIONS — the landscape lock and fullscreen flags, the audio session
# that stops the mute switch silencing the game, the bundle id and the generated
# versions, and the pod manifest. Untracked, `cap add ios` on another machine
# would quietly rebuild a portrait-capable, mute-switch-silenced app.
ios/*
!ios/App/
ios/App/*
!ios/App/App/
ios/App/App/*
!ios/App/App/Info.plist
!ios/App/App/AppDelegate.swift
!ios/App/App.xcodeproj/
ios/App/App.xcodeproj/*
!ios/App/App.xcodeproj/project.pbxproj
!ios/App/Podfile
# ---- the Android project ----
# Capacitor regenerates most of this from capacitor.config.json, so build
# output, Gradle caches and machine-local paths stay out. But five files carry
# DECISIONS rather than generated content — release signing, the SDK levels,
# the manifest's landscape lock, the generated version numbers, and the R8 keep
# rules — and if those are untracked then a fresh clone (or a `cap add android`)
# silently builds a differently-configured, unsigned app. They are re-included
# below.
#
# proguard-rules.pro is the newest and the least obvious: build.gradle turns R8
# ON, and the keep rules are the only reason that is safe. Tracking one without
# the other ships minification with no bridge rules — which builds clean, installs
# clean, and dies at launch.
android/*
!android/app/
android/app/*
!android/app/build.gradle
!android/app/proguard-rules.pro
!android/app/src/
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml
# the sideload build type's label lives here and is HAND-WRITTEN, not generated by
# Capacitor like main/ is — without it a clone gets the build type from
# build.gradle with nothing to rename the app, and both installs read the same.
!android/app/src/sideload/
!android/variables.gradle
!android/key.properties.example
.capacitor/
capacitor.config.json.bak
.claude/

# generated verifier bundle (rebuilt from src before every deploy)
supabase/functions/submit-run/_sim.mjs

# local-only impeccable state (DESIGN.md + design.json sidecar stay tracked)
.impeccable/config.local.json

# editor/lab scratch backups
*.bak

# one-off debug probes: written to answer one question, then done. They kept
# landing in the repo root because nothing stopped them (scratch-cap.js and
# scratch-tw.js both shipped by accident). Scratch work belongs outside the repo.
scratch-*.js

# lab crash-recovery working copies — session state, never source. The tracked
# copy of dest-tuning.json was how "my change did nothing" happened three times.
docs/dest-lab/dest-tuning.json
*.stale-bak

# scripts/bench.js sample dumps — one CSV per run, thousands of rows, and only
# meaningful next to the device and thermal state that produced them. The numbers
# worth keeping go in the commit message or a doc, not in the repo as data.
bench-results/

# ---- RELEASE SIGNING — never commit these ----
# The upload key is unrecoverable: commit or lose it and this listing can
# never be updated again. Play App Signing can reset an upload key; it cannot
# undo one that leaked. Kept out of the tree BEFORE any key exists.
*.jks
*.keystore
key.properties
android/key.properties

# derived: the behavioural fingerprint's cache, keyed on a source hash.
# Recomputing it is deterministic, so a committed copy would only ever be a
# stale answer someone trusted.
.sim-fingerprint.json
